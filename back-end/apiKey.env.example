# Copy this file to `apiKey.env` (which is gitignored) and fill in real values.
# Never commit real secrets.

# Scrape.do API token (Google/JS-rendering scraper)
SCRAPEDO_TOKEN=your_scrapedo_token_here

# Perplexity Sonar API key
PERPLEXITY_API_KEY=your_perplexity_key_here

# Internal Email Hub base URL
EMAILHUB_URL=http://localhost:8000
